/// How the order was placed: In store, Mobile order or Delivery.
table Channel
	lineageTag: 49aa4136-7903-48f0-afe1-74f48f74e5fb

	column 'Channel Key'
		dataType: int64
		isHidden
		isKey
		formatString: 0
		lineageTag: f60df5bc-40f0-439b-88e3-e715ef7bdce4
		summarizeBy: none
		sourceColumn: Channel Key

		annotation SummarizationSetBy = User

	column Channel
		dataType: string
		lineageTag: a612afb3-f2ec-4a0c-ab55-6cc5d9fa60a1
		summarizeBy: none
		sourceColumn: Channel
		sortByColumn: 'Channel Order'

		annotation SummarizationSetBy = Automatic

	column 'Channel Order'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 950a3de7-093a-49cf-ab74-93a8d5d12e36
		summarizeBy: none
		sourceColumn: Channel Order

		annotation SummarizationSetBy = User

	partition Channel = m
		mode: import
		queryGroup: Data
		source =
				let
				    FileName = "channel.csv",
				    Source = Csv.Document(
				        if Text.StartsWith(DataSource, "http", Comparer.OrdinalIgnoreCase) then Web.Contents(DataSource, [RelativePath = FileName]) else File.Contents(DataSource & FileName),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(
				        Promoted,
				        {{"Channel Key", Int64.Type}, {"Channel", type text}, {"Channel Order", Int64.Type}},
				        "en-GB"
				    )
				in
				    Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

