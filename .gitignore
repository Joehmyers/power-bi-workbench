.DS_Store
*.pyc
__pycache__/
.env
.venv/
*.log
# Agent instructions are committed (AGENTS.md, imported by CLAUDE.md);
# per-user Claude state stays local.
.claude/
*.tmuo
# Local dev builds live under tools/ subdirectories; the tracked tool
# definitions are the top-level YAML files and README.
/tools/*
!/tools/*.yaml
!/tools/README.md
# Adapter build output (Genie, OpenAI); the Claude adapter's output in
# plugins/ and .claude-plugin/ is committed instead.
dist/
tmp/
tests/
.worktrees/
node_modules/
package-lock.json
package.json
# Runtime-downloaded binaries, in both the neutral tree and generated output
hooks/pbi-desktop/bin/
skills/pbi-desktop/connect-pbid/bin/
plugins/pbi-desktop/hooks/bin/
plugins/pbi-desktop/skills/connect-pbid/bin/

# Per-machine Power BI Desktop state inside PBIP projects (projects/).
# The rest of a PBIP project is text source and belongs in git.
**/.pbi/localSettings.json
**/.pbi/cache.abf
